# Local Terraform variable values.
# Copy this file to terraform.tfvars and fill in your values.
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is gitignored — never commit it.

# ---- GCP Project Configuration ----
cicd_runner_project_id = "your-cicd-project-id"
staging_project_id     = "your-staging-project-id"
prod_project_id        = ""  # Leave empty if no prod yet
region                 = "us-central1"

# ---- Gemini Enterprise Configuration ----
ge_app_staging = ""   # Your staging GE App ID
ge_app_prod    = ""   # Your prod GE App ID
agents_region  = "global"

# ---- OAuth Configuration ----
oauth_client_id_secret_name = "client_secret"

# ---- Gemini Enterprise Authorization ID ----
auth_id = "a2a_langgraph_oauth_token_v4"

# ---- Agent Engine ID ----
# Populated automatically by deploy.sh from GCS state.
# agent_engine_id = "unset"
