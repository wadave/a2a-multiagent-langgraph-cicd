# Local environment variables for Python development and testing.
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is gitignored — never commit it.

# ---- GCP / Vertex AI Configuration ----
GOOGLE_GENAI_USE_VERTEXAI=1        # 1 = Vertex AI, 0 = ML Dev (Gemini API key)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
PROJECT_ID=your-project-id
PROJECT_NUMBER=your-project-number  # 12-digit GCP project number
BUCKET_NAME=your-project-id-bucket  # GCS bucket used as Vertex AI staging bucket

# ---- ML Dev backend (only needed when GOOGLE_GENAI_USE_VERTEXAI=0) ----
# GOOGLE_API_KEY=your-api-key-here

# ---- Deployed Agent Configuration ----
# Full resource name output by deploy_agents.py
AGENT_ENGINE_ID=projects/PROJECT_NUMBER/locations/REGION/reasoningEngines/AGENT_ID

# ---- MCP Server URLs ----
# Set explicitly for local dev. If unset, constructed from PROJECT_NUMBER + GOOGLE_CLOUD_LOCATION.
CT_MCP_SERVER_URL=https://cocktail-remote-mcp-server-lg-PROJECT_NUMBER.REGION.run.app/mcp/
WEA_MCP_SERVER_URL=https://weather-remote-mcp-server-lg-PROJECT_NUMBER.REGION.run.app/mcp/

# ---- Local Sub-agent URLs (when running agents locally) ----
CT_AGENT_URL=http://localhost:10002
WEA_AGENT_URL=http://localhost:10001

# ---- Debug / Logging ----
DEBUG_MODE=false
USE_CLOUD_LOGGING=FALSE     # Set to TRUE only when running inside GCP

# ---- Deployment Environment ----
ENVIRONMENT=staging         # staging | prod
